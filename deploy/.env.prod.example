# ===== Compose =====
# để gõ `docker compose ...` không cần -f
COMPOSE_FILE=docker-compose.prod.yml
DOCKERHUB_USERNAME=
BACKEND_TAG=0.9.0
FRONTEND_TAG=0.9.0

# ===== Domain / HTTPS =====
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
# CORS, đúng y chuỗi, không có "/" ở cuối
FRONTEND_URL=https://<APP_DOMAIN>

# ===== DB & JWT (chỉ dùng chuỗi hex, tránh ký tự $) =====
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# ===== Judge0 (private IP của EC2 Judge0) =====
JUDGE0_URL=http://<judge0-private-ip>:2358
JUDGE0_AUTH_TOKEN=
GRADING_WORKERS=4
JUDGE_LANGUAGES='{"java":{"memory_limit_kb":6144000}}'
GRADING_CHUNK_SIZE=10
# Ẩn Swagger /docs và /openapi.json trên production
API_DOCS_ENABLED=false

# ===== AI review (Tailscale IP 100.x của laptop) =====
OLLAMA_BASE_URL=http://<100.x.x.x>:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MAX_CONCURRENCY=2

APP_LOG_LEVEL=INFO
SEED_DEFAULT_PASSWORD=