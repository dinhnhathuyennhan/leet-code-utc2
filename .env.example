#DB & Jwt key
DB_SERVER=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

#Seed data
SEED_DEFAULT_PASSWORD=
SEED_DATA=

# Judge0
# Tên chuẩn của dự án (dùng cho Judge0 local trong docker-compose):
JUDGE0_AUTH_TOKEN=
JUDGE0_URL=
# Tên biến tương đương cho instance Judge0 dựng trên AWS/VPS.
# Nếu có đặt 2 nhóm này thì nhóm JUDGE0_URL/JUDGE0_AUTH_TOKEN được ưu tiên.
JUDGE0_API_TOKEN=
JUDGE0_API_URL=
# Mật khẩu nội bộ container judge0-db / judge0-redis KHÔNG nằm ở .env mà nằm
# trong file judge0.conf ở thư mục gốc (xem docs/judge0-setup.md).
# Chỉ cần JUDGE0_AUTH_TOKEN khớp với AUTHN_TOKEN trong judge0.conf.
JUDGE0_POSTGRES_PASSWORD=
JUDGE0_REDIS_PASSWORD=

JUDGE0_HTTP_TIMEOUT_SECONDS=10
JUDGE0_BATCH_SIZE=20
JUDGE0_RETRY_ATTEMPTS=3
JUDGE0_RETRY_BACKOFF_SECONDS=0.5
JUDGE0_POLL_INTERVAL_SECONDS=0.5
JUDGE0_POLL_RETRY_SECONDS=1.0
JUDGE0_MAX_CPU_TIME_SECONDS=15
JUDGE0_MAX_WALL_TIME_SECONDS=20
JUDGE0_WALL_TIME_FACTOR=2
JUDGE0_WALL_TIME_EXTRA_SECONDS=1

RUN_TIMEOUT_SECONDS=10
GRADING_TIMEOUT_SECONDS=300
GRADE_RETRY_DELAY_SECONDS=15
PENDING_TTL_MINUTES=10
GRADING_WORKERS=4
RUN_CONCURRENCY=10
MAX_CODE_BYTES=65536

JUDGE_LANGUAGES={"java":{"memory_limit_kb":8192000},"go":{"judge0_id":60,"cpu_time_factor":1}}

# AI Review (Ollama). Bỏ trống thì dùng mặc định: http://localhost:11434 + qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=12288
OLLAMA_NUM_PREDICT=1536
OLLAMA_MAX_CONCURRENCY=2