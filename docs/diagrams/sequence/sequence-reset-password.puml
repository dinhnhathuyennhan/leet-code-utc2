@startuml sequence-reset-password
' Đặt lại mật khẩu, theo backend/app/api/users.py và modules/users/service.py
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
autonumber

title Sơ đồ tuần tự - Đặt lại mật khẩu

actor "Admin /\nGiáo viên" as U
participant "Frontend\n(Next.js)" as FE
participant "User Router\n(FastAPI)" as R
participant "get_current_user\n(dependency)" as D
participant "UserService" as S
database "PostgreSQL" as DB
participant "Global\nException Handler" as EH

U -> FE : Chọn tài khoản, nhấn "Đặt lại mật khẩu"
FE -> R : POST /users/{user_id}/reset-password\nAuthorization: Bearer <access_token>
R -> D : Xác thực access token
D -> DB : SELECT user (người gọi)
DB --> D : current_user
break Token không hợp lệ hoặc token_version lệch
  D -->> EH : raise UnauthorizedError
  EH --> FE : 401
end
D --> R : current_user

R -> S : reset_password(current_user, user_id)
S -> DB : SELECT user WHERE user_id = ?
DB --> S : target | null
break Không tìm thấy tài khoản
  S -->> EH : raise UserNotFoundError
  EH --> FE : 404
end

break Người gọi là Sinh viên
  S -->> EH : raise NotAllowedToResetError
  EH --> FE : 403
end

opt Người gọi là Giáo viên
  S -> DB : Lấy các course do Giáo viên tạo\nvà kiểm tra target có enrollment trong đó
  DB --> S : enrollment | null
  break Target không phải Sinh viên, hoặc không học lớp của Giáo viên
    S -->> EH : raise NotAllowedToResetError
    EH --> FE : 403
  end
end
note right of S : Admin được đặt lại mật khẩu mọi tài khoản

S -> S : Sinh mật khẩu tạm\n(Sinh viên = MSSV, Giáo viên/Admin = ngày sinh ddmmyyyy)
S -> DB : UPDATE user SET hashed_password = hash(tạm),\nmust_change_password = true,\ntoken_version = token_version + 1
DB --> S : OK
S --> R : (user_id, mật khẩu tạm)
R --> FE : 200 {user_id, temporary_password}
FE --> U : Hiển thị mật khẩu tạm (chỉ 1 lần)

note over DB
  token_version tăng nên mọi access/refresh token
  cũ của tài khoản mục tiêu đều bị vô hiệu hoá
end note

@enduml
