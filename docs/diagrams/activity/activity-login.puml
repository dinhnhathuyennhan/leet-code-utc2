@startuml activity-login
' Đăng nhập + bắt buộc đổi mật khẩu tạm ở lần đầu
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title Sơ đồ hoạt động - Đăng nhập và đổi mật khẩu lần đầu

|Người dùng|
start
:Mở trang đăng nhập;
repeat
  :Nhập email và mật khẩu;
  :Nhấn "Đăng nhập";
  |Hệ thống|
  :Tìm tài khoản theo email;
  :Kiểm tra mật khẩu;
  backward :Hiển thị "Email hoặc mật khẩu không đúng";
repeat while (Thông tin hợp lệ?) is (không) not (có)
:Tạo access token và refresh token;
:Lưu refresh token vào cookie HttpOnly;
if (must_change_password = true?) then (có)
  :Chuyển tới trang "Đổi mật khẩu";
  |Người dùng|
  repeat
    :Nhập mật khẩu hiện tại,
    mật khẩu mới, xác nhận;
    |Hệ thống|
    backward :Hiển thị lỗi tương ứng;
  repeat while (Mật khẩu hiện tại đúng\nvà mật khẩu mới khác mật khẩu cũ?) is (không) not (có)
  :Lưu mật khẩu mới (đã băm);
  :Đặt must_change_password = false;
  :Tăng token_version, cấp token mới;
else (không)
endif
:Chuyển tới trang chủ theo vai trò;
|Người dùng|
:Sử dụng hệ thống;
stop

@enduml
