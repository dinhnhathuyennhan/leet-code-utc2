@startuml erd
' Sơ đồ thực thể - quan hệ (ERD), lấy theo backend/app/models/entities.py
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho
skinparam defaultFontName Arial
hide circle
hide methods

title Sơ đồ cơ sở dữ liệu (ERD) - Hệ thống Chấm Code

entity "class\n(Lớp hành chính)" as e_class {
  * <b>class_id</b> : varchar(50) <<PK>>
  --
  * type : varchar
  * course_number : int
  * department : varchar
}

entity "user\n(Tài khoản)" as e_user {
  * <b>user_id</b> : uuid <<PK>>
  --
  student_code : varchar(20) <<UNIQUE>>
  * full_name : varchar
  avt_link : varchar(2048)
  * email : varchar(255) <<UNIQUE>>
  * hashed_password : varchar
  * must_change_password : bool
  * role_id : int
  * token_version : int
  * is_active : bool
  locked_by : uuid <<FK>>
  class_id : varchar(50) <<FK>>
}

entity "course\n(Lớp học phần)" as e_course {
  * <b>course_id</b> : varchar(50) <<PK>>
  --
  * course_name : varchar
  avt_link : varchar(2048)
  * created_by : uuid <<FK>>
  * term : varchar
  * start_date : timestamptz
  * end_date : timestamptz
  * total_number_student : int
}

entity "enrollment\n(Ghi danh)" as e_enrollment {
  * <b>enrollment_id</b> : int <<PK>>
  --
  * course_id : varchar(50) <<FK>>
  * student_id : uuid <<FK>>
  ..
  (course_id, student_id) <<UNIQUE>>
}

entity "lesson\n(Buổi học)" as e_lesson {
  * <b>lesson_id</b> : int <<PK>>
  --
  * lesson_number : int
  * lesson_name : varchar
  * course_id : varchar(50) <<FK>>
  * total_number_assignment : int
  * total_number_student_finished : int
  * start_date : date
  * end_date : date
}

entity "problem\n(Bài tập)" as e_problem {
  * <b>problem_id</b> : int <<PK>>
  --
  * lesson_id : int <<FK>>
  * title : varchar
  function_name : varchar
  * description : text
  * time_limit_seconds : int
  * start_format_code : text
  * starter_codes : json
  * constraints : text
  * level : varchar
  hint : text
  complexity : varchar
  * start_datetime : timestamptz
  * end_datetime : timestamptz
  * total_number_testcase : int
  report : text
}

entity "testcase\n(Bộ test)" as e_testcase {
  * <b>testcase_id</b> : int <<PK>>
  --
  * problem_id : int <<FK>>
  * input : text
  * expected_output : text
  * is_sample : bool
  * input_type : varchar
  * expected_output_type : varchar
}

entity "submission\n(Bài nộp)" as e_submission {
  * <b>submission_id</b> : int <<PK>>
  --
  * problem_id : int <<FK>>
  * student_id : uuid <<FK>>
  * language : varchar
  * submitted_code : text
  * status : varchar
  compile_output : text
  feedback : text
  manual_score : float
  * passed_count : int
  * submitted_datetime : timestamptz
  judge_tokens : json
  result_marker : varchar(64)
  testcase_results : json
  grading_claimed_at : timestamptz
}

entity "ai_review_usage
(Lượt AI review)" as e_ai_review_usage {
  * <b>usage_id</b> : int <<PK>>
  --
  * student_id : uuid <<FK>>
  * problem_id : int <<FK>>
  * submission_id : int <<FK>>
  * attempt_no : int
  * created_at : timestamptz
  ..
  (student_id, problem_id, attempt_no) <<UNIQUE>>
}

e_class |o--o{ e_user : "gồm"
e_user |o--o{ e_user : "khoá (locked_by)"
e_user ||--o{ e_course : "tạo (created_by)"
e_user ||--o{ e_enrollment : "ghi danh"
e_course ||--o{ e_enrollment : "có"
e_course ||--o{ e_lesson : "gồm"
e_lesson ||--o{ e_problem : "gồm"
e_problem ||--o{ e_testcase : "có"
e_problem ||--o{ e_submission : "nhận"
e_user ||--o{ e_submission : "nộp"
e_user ||--o{ e_ai_review_usage : "dùng lượt"
e_problem ||--o{ e_ai_review_usage : "giới hạn theo"
e_submission ||--o{ e_ai_review_usage : "review"

legend right
  * : cột NOT NULL
  role_id: 1 = Admin, 2 = Giáo viên, 3 = Sinh viên
  user.class_id chỉ có giá trị với Sinh viên
  user.locked_by: người đã khoá tài khoản (NULL khi đang hoạt động), ON DELETE SET NULL
  submission.grading_claimed_at: lease của worker đang chấm (NULL khi không ai giữ)
  login_attempt: đếm đăng nhập sai theo email (không FK, email chưa có tài khoản cũng được đếm)
  ai_review_usage: mỗi SV tối đa AI_REVIEW_MAX_PER_PROBLEM lượt/problem (attempt_no 1..giới hạn)
endlegend

@enduml
