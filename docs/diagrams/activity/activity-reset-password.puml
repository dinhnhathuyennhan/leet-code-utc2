@startuml activity-reset-password
' Đặt lại mật khẩu, theo modules/users/service.py::reset_password
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title Sơ đồ hoạt động - Đặt lại mật khẩu

|Admin / Giáo viên|
start
:Chọn tài khoản trong danh sách;
:Nhấn "Đặt lại mật khẩu";
|Hệ thống|
if (Tài khoản mục tiêu tồn tại?) then (không)
  :Báo lỗi "Không tìm thấy tài khoản";
  stop
endif
switch (Vai trò người gọi?)
case (Sinh viên)
  :Báo lỗi không có quyền;
  stop
case (Giáo viên)
  if (Mục tiêu là Sinh viên đang học\nlớp học phần do Giáo viên tạo?) then (không)
    :Báo lỗi không có quyền;
    stop
  endif
case (Admin)
endswitch
switch (Vai trò tài khoản mục tiêu?)
case (Sinh viên)
  :Mật khẩu tạm = MSSV;
case (Giáo viên / Admin)
  if (Đã có ngày sinh?) then (có)
    :Mật khẩu tạm = ngày sinh (ddmmyyyy);
  else (không)
    :Báo lỗi thiếu ngày sinh;
    stop
  endif
endswitch
:Băm và lưu mật khẩu tạm;
:Đặt must_change_password = true;
:Tăng token_version
(vô hiệu hoá mọi phiên cũ);
:Trả mật khẩu tạm (chỉ 1 lần);
|Admin / Giáo viên|
:Ghi nhận và gửi mật khẩu tạm
cho chủ tài khoản;
stop

@enduml
