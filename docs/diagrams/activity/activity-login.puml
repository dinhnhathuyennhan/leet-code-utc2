@startuml activity-login
' Đăng nhập + bắt buộc đổi mật khẩu tạm ở lần đầu
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial

title Sơ đồ hoạt động - Đăng nhập và đổi mật khẩu lần đầu

|Người dùng|
start
:Mở trang đăng nhập;
repeat
  :Nhập email và mật khẩu;
  :Nhấn "Đăng nhập";
  |Hệ thống|
  if (Email đang bị tạm chặn\n(sai quá nhiều lần)?) then (có)
    :Hiển thị "Bạn đã đăng nhập sai quá nhiều lần.
    Vui lòng thử lại sau {n} phút";
    note right
      Không kiểm tra mật khẩu.
      Gỡ chặn khi hết thời gian, hoặc khi
      Admin/Giáo viên đặt lại mật khẩu, mở khoá
    end note
    stop
  else (không)
  endif
  :Tính lượt này vào bộ đếm
  (chạm ngưỡng thì đặt mốc chặn);
  :Tìm tài khoản theo email;
  :Kiểm tra mật khẩu;
  backward :Hiển thị "Email hoặc mật khẩu không đúng"
  (lượt chạm ngưỡng thì báo bị tạm chặn);
repeat while (Thông tin hợp lệ?) is (không) not (có)
if (Tài khoản đang bị khoá?) then (có)
  :Hiển thị "Tài khoản đã bị khoá"
  (lượt chạm ngưỡng thì báo bị tạm chặn);
  note right
    Chỉ báo khoá khi mật khẩu đúng,
    sai mật khẩu vẫn nhận lỗi chung.
    Lượt này vẫn tính là lượt sai
  end note
  stop
else (không)
endif
:Xoá bộ đếm đăng nhập sai;
:Tạo access token và refresh token;
:Lưu refresh token vào cookie HttpOnly;
if (must_change_password = true?) then (có)
  :Chuyển tới trang "Đổi mật khẩu";
  |Người dùng|
  repeat
    :Nhập mật khẩu hiện tại,
    mật khẩu mới, xác nhận;
    |Hệ thống|
    backward :Hiển thị lỗi tương ứng;
  repeat while (Mật khẩu hiện tại đúng\nvà mật khẩu mới khác mật khẩu cũ?) is (không) not (có)
  :Lưu mật khẩu mới (đã băm);
  :Đặt must_change_password = false;
  :Tăng token_version, cấp token mới;
else (không)
endif
:Chuyển tới trang chủ theo vai trò;
|Người dùng|
:Sử dụng hệ thống;
stop

@enduml
